{
  "name": "wwdc-mcp-server",
  "version": "0.2.1",
  "description": "Apple developer intelligence for coding agents: WWDC26, docs, HIG, Swift, App Review, API intelligence, and source-grounded app audits",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "wwdc-mcp-server": "dist/index.js",
    "wwdc-mcp-ingest": "dist/ingest/run.js"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "dev:http": "tsx src/mcp-http.ts",
    "start:http": "node dist/mcp-http.js",
    "ingest": "tsx src/ingest/run.ts",
    "ingest:wwdc": "tsx src/ingest/run.ts --source wwdc",
    "ingest:tutorials": "tsx src/ingest/run.ts --source tutorials",
    "ingest:hig": "tsx src/ingest/run.ts --source hig",
    "ingest:evolution": "tsx src/ingest/run.ts --source evolution",
    "ingest:docs": "tsx src/ingest/run.ts --source docs",
    "ingest:swiftbook": "tsx src/ingest/run.ts --source swiftbook",
    "ingest:appstore": "tsx src/ingest/run.ts --source appstore",
    "ingest:all": "tsx src/ingest/run.ts --source all",
    "smoke": "tsx tests/smoke.ts",
    "health:native": "node -e \"require('better-sqlite3'); console.log('better-sqlite3 native addon OK')\"",
    "test": "tsx tests/smoke.ts && tsx tests/ingest-parse.ts && tsx tests/security-eval.ts && tsx tests/mcp-e2e.ts && tsx tests/search-regression.ts && tsx tests/search-did-you-mean.ts && tsx tests/eval.ts && tsx tests/package-smoke.ts && tsx tests/mcp-http.ts && tsx tests/optional-service.ts && tsx tests/corpus-version.ts && tsx tests/ingest-status-honesty.ts && tsx tests/verify-corpus-script.ts",
    "test:parse": "tsx tests/ingest-parse.ts",
    "test:e2e": "tsx tests/mcp-e2e.ts",
    "test:http": "tsx tests/mcp-http.ts",
    "test:security": "tsx tests/security-eval.ts",
    "test:package": "tsx tests/package-smoke.ts",
    "test:live": "tsx tests/ingest-live.ts",
    "eval": "tsx tests/eval.ts",
    "test:search-regression": "tsx tests/search-regression.ts",
    "test:inspector": "WWDC_SKIP_EMBEDDINGS=1 npx -y @modelcontextprotocol/inspector --cli node dist/index.js --method tools/list --format json > /tmp/wwdc-mcp-inspector.json && node -e \"const fs=require('fs');const x=JSON.parse(fs.readFileSync('/tmp/wwdc-mcp-inspector.json','utf8'));const tools=x.result?.tools||[];if(tools.length!==45)throw new Error('Expected 45 tools, got '+tools.length);console.log('[inspector] external MCP client sees 45 tools')\"",
    "verify:corpus": "tsx scripts/verify-corpus.ts"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wwdc",
    "wwdc26",
    "apple",
    "apple-developer",
    "developer-documentation",
    "swift",
    "swiftui",
    "ios",
    "macos",
    "xcode",
    "appkit",
    "uikit",
    "storekit",
    "app-store",
    "app-store-review",
    "apple-intelligence",
    "foundation-models",
    "human-interface-guidelines",
    "swift-evolution",
    "codex",
    "claude",
    "cursor",
    "local-first",
    "semantic-search"
  ],
  "author": "Scott Manthey",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jabbertones-cloud/wwdc-mcp-server.git"
  },
  "homepage": "https://github.com/jabbertones-cloud/wwdc-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/jabbertones-cloud/wwdc-mcp-server/issues"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.0.0",
    "p-limit": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "mcpName": "io.github.jabbertones-cloud/wwdc"
}
