{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wwdc-mcp",
  "main": "deploy/cloudflare/worker.js",
  "compatibility_date": "2026-10-07",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "wwdc-mcp.smatdesigns.com", "custom_domain": true }],
  "containers": [{
    "class_name": "WwdcContainer",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "./deploy/cloudflare/Dockerfile", "build_context": "." } }
  }],
  "durable_objects": { "bindings": [{ "name": "WWDC_CONTAINER", "class_name": "WwdcContainer" }] },
  "exports": { "WwdcContainer": { "type": "durable-object", "storage": "sqlite" } }
}
